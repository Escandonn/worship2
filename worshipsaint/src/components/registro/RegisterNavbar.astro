---
import logo from '../../assets/logo.png';
---

<a
  href="/"
  style={{
    position: 'fixed',
    top: 0,
    left: 0,
    right: 0,
    zIndex: 50,
    display: 'flex',
    flexDirection: 'column',
    alignItems: 'center',
    justifyContent: 'center',
    gap: '0.6rem',
    padding: '1.25rem 1.5rem 0.9rem',
    background: 'rgba(248,246,242,0.92)',
    backdropFilter: 'blur(12px)',
    WebkitBackdropFilter: 'blur(12px)',
    borderBottom: '1px solid rgba(200,169,106,0.15)'
  }}
>
  <div style={{ display: 'inline-flex', alignItems: 'center', gap: '0.6rem' }}>
    <img
      src={logo.src}
      alt="WorshipSaint"
      style={{
        width: '32px',
        height: '32px',
        objectFit: 'cover',
        borderRadius: '999px'
      }}
    />
    <span
      style={{
        fontFamily: 'var(--ws-font)',
        fontWeight: 800,
        fontSize: '1.05rem',
        color: 'var(--ws-text)',
        letterSpacing: '0.02em',
        transition: 'color 300ms ease'
      }}
      onmouseover="this.style.color='var(--ws-accent)'"
      onmouseout="this.style.color='var(--ws-text)'"
    >
      WorshipSaint
    </span>
  </div>

  <a
    href="/"
    style={{
      fontFamily: 'var(--ws-font)',
      fontWeight: 600,
      fontSize: '0.85rem',
      color: 'var(--ws-text)',
      textDecoration: 'none',
      position: 'relative',
      padding: '0.2rem 0'
    }}
    onmouseover="this.style.color='var(--ws-accent)'"
    onmouseout="this.style.color='var(--ws-text)'"
  >
    Inicio
    <span
      style={{
        position: 'absolute',
        bottom: 0,
        left: 0,
        width: '0%',
        height: '2px',
        background: 'var(--ws-accent)',
        transition: 'width 300ms ease'
      }}
      onmouseover="this.style.width='100%'"
      onmouseout="this.style.width='0%'"
    ></span>
  </a>
</a>
