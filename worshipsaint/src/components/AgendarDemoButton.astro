---
interface Props {
  onClick?: () => void;
}

const { onClick } = Astro.props;
---

<div class="agendar-demo-wrapper">
  <span class="agendar-demo-label">Agendar Demo</span>
  <button
    type="button"
    class="agendar-demo-button"
    onClick={() => {
      if (onClick) {
        onClick();
      } else {
        window.location.href = '/registro';
      }
    }}
    aria-label="Regístrate con Google"
  >
    <svg
      width="20"
      height="20"
      viewBox="0 0 24 24"
      aria-hidden="true"
      style="flex-shrink: 0"
    >
      <path
        d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"
        fill="#4285F4"
      />
      <path
        d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
        fill="#34A853"
      />
      <path
        d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
        fill="#FBBC05"
      />
      <path
        d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l2.85 2.22c.87-2.6 3.3-4.53 6.16-4.53z"
        fill="#EA4335"
      />
    </svg>
    Regístrate con Google
  </button>
</div>

<style>
  .agendar-demo-wrapper {
    position: fixed;
    left: 1.5rem;
    bottom: 1.5rem;
    z-index: 210;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    animation: demoFloat 8s ease-in-out infinite;
    will-change: transform;
  }

  .agendar-demo-label {
    font-family: var(--ws-font);
    font-size: 0.85rem;
    font-weight: 700;
    color: #2c2118;
    background: rgba(248, 246, 242, 0.92);
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    border: 1px solid rgba(200, 169, 106, 0.35);
    box-shadow: 0 6px 18px rgba(44, 33, 24, 0.12);
    white-space: nowrap;
    opacity: 0;
    animation: demoFadeIn 8s ease-in-out infinite;
  }

  .agendar-demo-button {
    width: min(320px, 90%);
    max-width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 0.95rem 1.5rem;
    border-radius: var(--ws-radius-btn);
    border: 1px solid rgba(44, 33, 24, 0.12);
    background: #fff;
    color: #2c2118;
    font-family: var(--ws-font);
    font-weight: 700;
    font-size: 1rem;
    cursor: pointer;
    box-shadow: var(--ws-shadow-card);
    transition: transform 250ms ease, box-shadow 250ms ease;
  }

  .agendar-demo-button:hover {
    transform: translateY(-2px) scale(1.01);
    box-shadow: 0 18px 40px rgba(44, 33, 24, 0.14);
  }

  .agendar-demo-button:active {
    transform: translateY(0) scale(1);
    box-shadow: var(--ws-shadow-card);
  }

  @keyframes demoFloat {
    0% {
      transform: translateX(0);
    }
    35% {
      transform: translateX(80px);
    }
    45% {
      transform: translateX(80px);
    }
    65% {
      transform: translateX(0);
    }
    75% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(0);
    }
  }

  @keyframes demoFadeIn {
    0%,
    15% {
      opacity: 0;
      transform: translateY(6px);
    }
    25%,
    45% {
      opacity: 1;
      transform: translateY(0);
    }
    60%,
    100% {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  @media (max-width: 768px) {
    .agendar-demo-wrapper {
      left: 1rem;
      bottom: 2rem;
      animation-name: demoFloatMobile;
    }

    .agendar-demo-button {
      width: min(260px, 78vw);
      max-width: 100%;
      padding: 0.7rem 1.2rem;
      border-radius: 999px;
      background: #fff;
      color: #2c2118;
      border: 1px solid rgba(44, 33, 24, 0.12);
      box-shadow: var(--ws-shadow-card);
      font-weight: 700;
      font-size: 0.95rem;
    }

    .agendar-demo-button:hover {
      transform: translateY(-2px) scale(1.01);
      box-shadow: 0 18px 40px rgba(44, 33, 24, 0.14);
    }

    @keyframes demoFloatMobile {
      0% {
        transform: translateX(0);
      }
      35% {
        transform: translateX(30px);
      }
      45% {
        transform: translateX(30px);
      }
      65% {
        transform: translateX(0);
      }
      75% {
        transform: translateX(0);
      }
      100% {
        transform: translateX(0);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .agendar-demo-wrapper {
      animation: none;
    }
    .agendar-demo-label {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
