---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'WorshipSaint — Premium',
  description = 'WorshipSaint: diseño premium, minimalista y atemporal.'
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />

		<!-- Fuentes: Poppins + Manrope -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Poppins:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>

		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--ws-bg: #f8f6f2;
		--ws-surface: #ece5da;
		--ws-secondary: #d6c3a5;
		--ws-accent: #c8a96a;
		--ws-text: #2c2118;
		--ws-muted: #a89880;
		--ws-footer-bg: #2c2118;
		--ws-footer-text: #ece5da;

		--ws-font: 'Manrope', 'Poppins', system-ui, sans-serif;

		--ws-shadow-card: 0 10px 35px rgba(44, 33, 24, 0.08);
		--ws-shadow-elevated: 0 20px 60px rgba(44, 33, 24, 0.10);
		--ws-shadow-btn: 0 8px 25px rgba(200, 169, 106, 0.30);
		--ws-shadow-btn-hover: 0 15px 45px rgba(200, 169, 106, 0.45);

		--ws-radius-card: 30px;
		--ws-radius-btn: 18px;
		--ws-radius-input: 16px;
		--ws-radius-base: 24px;

		--ws-gradient-bg: linear-gradient(135deg, #f8f6f2 0%, #ece5da 45%, #d6c3a5 100%);
		--ws-gradient-card: linear-gradient(180deg, rgba(255,255,255,0.55), rgba(236,229,218,0.75));
		--ws-gradient-btn: linear-gradient(135deg, #d6c3a5, #c8a96a);
		--ws-gradient-btn-hover: linear-gradient(135deg, #c8a96a, #d6c3a5);
		--ws-gradient-btn-secondary: linear-gradient(180deg, #f8f6f2, #ece5da);
		--ws-gradient-premium: linear-gradient(135deg, #ece5da, #d6c3a5, #c8a96a);
		--ws-gradient-footer: linear-gradient(180deg, #2c2118, #1c150f);

		--ws-transition: 0.4s ease-in-out;
	}

	html {
		scroll-behavior: smooth;
	}

	html,
	body {
		margin: 0;
		padding: 0;
		width: 100%;
		min-height: 100%;
		background-color: var(--ws-bg);
		color: var(--ws-text);
		font-family: var(--ws-font);
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}

	* {
		box-sizing: border-box;
	}

	::selection {
		background-color: var(--ws-accent);
		color: var(--ws-bg);
	}

	::-webkit-scrollbar {
		width: 10px;
	}
	::-webkit-scrollbar-track {
		background: var(--ws-surface);
	}
	::-webkit-scrollbar-thumb {
		background: var(--ws-secondary);
		border-radius: 999px;
	}
	::-webkit-scrollbar-thumb:hover {
		background: var(--ws-accent);
	}
</style>
