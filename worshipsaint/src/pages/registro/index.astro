---
import Layout from '../../layouts/Layout.astro';
import RegisterNavbar from '../../components/registro/RegisterNavbar.astro';
import RegisterForm from '../../components/registro/RegisterForm.tsx';
import ParticleBackground from '../../components/registro/ParticleBackground.tsx';
---

<Layout>
  <RegisterNavbar />
  <main
    style={{
      position: 'relative',
      minHeight: '100vh',
      display: 'flex',
      alignItems: 'center',
      justifyContent: 'center',
      padding: '6rem 1.25rem 3rem',
      overflow: 'hidden'
    }}
  >
    <ParticleBackground />

    <div
      style={{
        position: 'relative',
        zIndex: 1,
        width: '100%',
        maxWidth: '420px',
        display: 'flex',
        flexDirection: 'column',
        alignItems: 'center',
        gap: '1.5rem'
      }}
    >
      <div
        style={{
          textAlign: 'center',
          display: 'flex',
          flexDirection: 'column',
          gap: '0.6rem'
        }}
      >
        <span
          style={{
            fontFamily: 'var(--ws-font)',
            fontSize: '0.8rem',
            fontWeight: 700,
            letterSpacing: '0.18em',
            textTransform: 'uppercase',
            color: 'var(--ws-accent)'
          }}
        >
          Agenda tu demo
        </span>
        <h1
          style={{
            fontFamily: 'var(--ws-font)',
            fontSize: 'clamp(1.6rem, 4vw, 2.2rem)',
            fontWeight: 800,
            color: 'var(--ws-text)',
            margin: 0,
            lineHeight: 1.15
          }}
        >
          Mantente al tanto del ecosistema WorshipSaint.
        </h1>
        <p
          style={{
            fontFamily: 'var(--ws-font)',
            fontSize: '0.95rem',
            color: 'var(--ws-muted)',
            margin: 0,
            lineHeight: 1.5
          }}
        >
          Agenda una demo y forma parte de la evolución tecnológica, espiritual y deportiva que estamos construyendo.
        </p>
      </div>

      <RegisterForm />
    </div>
  </main>

  <style>
    /* Ocultar botón flotante de demo en la página de registro */
    .agendar-demo-wrapper {
      display: none !important;
    }
  </style>
</Layout>
