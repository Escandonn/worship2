---
import Layout from '../../layouts/Layout.astro';
import RegisterNavbar from '../../components/registro/RegisterNavbar.astro';
import RegisterForm from '../../components/registro/RegisterForm.tsx';
import ParticleBackground from '../../components/registro/ParticleBackground.tsx';
import GoogleRegisterButton from '../../components/GoogleRegisterButton';
---

<Layout>
  <RegisterNavbar />
  <main
    style={{
      position: 'relative',
      minHeight: '100vh',
      display: 'flex',
      alignItems: 'center',
      justifyContent: 'center',
      padding: '6rem 1.25rem 3rem',
      overflow: 'hidden'
    }}
  >
    <ParticleBackground />

    <div
      style={{
        position: 'relative',
        zIndex: 1,
        width: '100%',
        maxWidth: '420px',
        display: 'flex',
        flexDirection: 'column',
        alignItems: 'center',
        gap: '1.5rem'
      }}
    >
      <div
        style={{
          textAlign: 'center',
          display: 'flex',
          flexDirection: 'column',
          gap: '0.6rem'
        }}
      >
        <span
          style={{
            fontFamily: 'var(--ws-font)',
            fontSize: '0.8rem',
            fontWeight: 700,
            letterSpacing: '0.18em',
            textTransform: 'uppercase',
            color: 'var(--ws-accent)'
          }}
        >
          Bienvenido al ecosistema
        </span>
        <h1
          style={{
            fontFamily: 'var(--ws-font)',
            fontSize: 'clamp(1.6rem, 4vw, 2.2rem)',
            fontWeight: 800,
            color: 'var(--ws-text)',
            margin: 0,
            lineHeight: 1.15
          }}
        >
          Forma parte de WorshipSaint.
        </h1>
        <p
          style={{
            fontFamily: 'var(--ws-font)',
            fontSize: '0.95rem',
            color: 'var(--ws-muted)',
            margin: 0,
            lineHeight: 1.5
          }}
        >
          Crea tu cuenta y descubre una nueva forma de conectar con nuestro ecosistema.
        </p>
      </div>

      <RegisterForm />

      <div
        style={{
          width: '100%',
          display: 'flex',
          alignItems: 'center',
          gap: '0.8rem',
          color: 'var(--ws-muted)',
          fontFamily: 'var(--ws-font)',
          fontSize: '0.85rem'
        }}
      >
        <span style={{ flex: 1, height: '1px', background: 'rgba(44,33,24,0.12)' }}></span>
        <span>o</span>
        <span style={{ flex: 1, height: '1px', background: 'rgba(44,33,24,0.12)' }}></span>
      </div>

      <div style={{ width: '100%', display: 'flex', justifyContent: 'center' }}>
        <GoogleRegisterButton onRegister={() => console.log('[Registro] Google pendiente de Firebase.')} />
      </div>

      <p
        style={{
          fontFamily: 'var(--ws-font)',
          fontSize: '0.85rem',
          color: 'var(--ws-muted)',
          textAlign: 'center',
          margin: 0
        }}
      >
        ¿Ya tienes una cuenta?
        <a
          href="/"
          style={{
            marginLeft: '0.35rem',
            color: 'var(--ws-accent)',
            fontWeight: 700,
            textDecoration: 'none'
          }}
        >
          Iniciar sesión
        </a>
      </p>
    </div>
  </main>
</Layout>
